{
  "openapi": "3.1.0",
  "info": {
    "title": "resume-forge",
    "description": "CV como código: currículo LaTeX ATS-friendly a partir de YAML",
    "version": "0.1.0"
  },
  "paths": {
    "/health/v1/liveness": {
      "get": {
        "tags": [
          "HEALTH"
        ],
        "summary": "Health Liveness",
        "description": "Return the liveness status.\n\nThe probe touches no dependency. It fails only when the process cannot\nanswer HTTP requests, which is the case a restart fixes.\n\nReturns\n-------\nstr\n    The liveness status as a plain-text response.",
        "operationId": "HEALTH-health_liveness",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/health/v1/readiness": {
      "get": {
        "tags": [
          "HEALTH"
        ],
        "summary": "Health Readiness",
        "description": "Return the readiness status after pinging the database.\n\nReturns\n-------\nstr\n    The readiness status as a plain-text response.\n\nRaises\n------\nHTTPException\n    With status 503 when the database is not configured or does not\n    answer.",
        "operationId": "HEALTH-health_readiness",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/challenges": {
      "post": {
        "tags": [
          "AUTHENTICATION"
        ],
        "summary": "Request Authentication Code",
        "description": "Request a one-time login code delivered by email.\n\nReturns\n-------\nAuthenticationChallengeResource\n    Public challenge information, the same for known and new emails.\n\nRaises\n------\nHTTPException\n    If the request is invalid, rate-limited, or the email cannot be sent.",
        "operationId": "AUTHENTICATION-request_authentication_code",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthenticationChallengeRequestResource"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationChallengeResource"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/challenges/{challenge_id}/verify": {
      "post": {
        "tags": [
          "AUTHENTICATION"
        ],
        "summary": "Verify Authentication Code",
        "description": "Verify a one-time code and issue access and refresh tokens.\n\nThe first verified code of an email creates its account.\n\nReturns\n-------\nAuthenticationSessionResource | JSONResponse\n    Issued token pair, or a generic unauthorized response.\n\nRaises\n------\nHTTPException\n    If the device metadata is invalid or authentication is not configured.",
        "operationId": "AUTHENTICATION-verify_authentication_code",
        "parameters": [
          {
            "name": "challenge_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$",
              "title": "Challenge Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthenticationCodeResource"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationSessionResource"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired, consumed, or blocked code."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "AUTHENTICATION"
        ],
        "summary": "Refresh Authentication Session",
        "description": "Rotate a refresh token and return a new token pair.\n\nReturns\n-------\nAuthenticationSessionResource | JSONResponse\n    Rotated token pair, or a generic unauthorized response.",
        "operationId": "AUTHENTICATION-refresh_authentication_session",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthenticationRefreshResource"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationSessionResource"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired, consumed, or reused refresh token."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/sessions": {
      "get": {
        "tags": [
          "AUTHENTICATION"
        ],
        "summary": "Read Authenticated Sessions",
        "description": "List active device sessions owned by the current user.\n\nReturns\n-------\nAuthenticationSessionListResource\n    Active sessions without token digests.",
        "operationId": "AUTHENTICATION-read_authenticated_sessions",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationSessionListResource"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/auth/sessions/{auth_session_id}": {
      "delete": {
        "tags": [
          "AUTHENTICATION"
        ],
        "summary": "Delete Authenticated Session",
        "description": "Revoke one device session owned by the current user.\n\nRaises\n------\nHTTPException\n    If the session does not exist or belongs to another user.",
        "operationId": "AUTHENTICATION-delete_authenticated_session",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "auth_session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Auth Session Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "AUTHENTICATION"
        ],
        "summary": "Logout",
        "description": "Revoke a session using its long-lived refresh token.",
        "operationId": "AUTHENTICATION-logout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthenticationRefreshResource"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "ME"
        ],
        "summary": "Read Me",
        "description": "Return the authenticated user with their preferences.\n\nReturns\n-------\nUserResource\n    The authenticated user.",
        "operationId": "ME-read_me",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResource"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "patch": {
        "tags": [
          "ME"
        ],
        "summary": "Update Me",
        "description": "Update the name and preferences of the authenticated user.\n\nReturns\n-------\nUserResource\n    The updated user.\n\nRaises\n------\nHTTPException\n    With status 422 when the template does not exist.",
        "operationId": "ME-update_me",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdateResource"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResource"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/resume": {
      "get": {
        "tags": [
          "RESUME"
        ],
        "summary": "Read Resume",
        "description": "Return the master resume.\n\nReturns\n-------\nResumeResource\n    The validated content of ``cv.yaml``.",
        "operationId": "RESUME-read_resume",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeResource"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/resume/templates": {
      "get": {
        "tags": [
          "RESUME"
        ],
        "summary": "Read Templates",
        "description": "List the resume templates.\n\nReturns\n-------\nlist[TemplateResource]\n    Templates sorted by name.",
        "operationId": "RESUME-read_templates",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TemplateResource"
                  },
                  "type": "array",
                  "title": "Response Resume-Read Templates"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/resume/text": {
      "get": {
        "tags": [
          "RESUME"
        ],
        "summary": "Read Resume Text",
        "description": "Return the resume as plain text, to paste in ATS forms.\n\nReturns\n-------\nstr\n    Plain text of the resume.",
        "operationId": "RESUME-read_resume_text",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Lang",
              "description": "Language of the resume.",
              "default": "pt"
            },
            "description": "Language of the resume."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/resume/pdf": {
      "get": {
        "tags": [
          "RESUME"
        ],
        "summary": "Build Resume Pdf",
        "description": "Build the resume and return the PDF.\n\nReturns\n-------\nFileResponse\n    The PDF of the resume.",
        "operationId": "RESUME-build_resume_pdf",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "template",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "description": "Template name.",
              "default": "classic",
              "title": "Template"
            },
            "description": "Template name."
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Lang",
              "description": "Language of the resume.",
              "default": "pt"
            },
            "description": "Language of the resume."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/pdf": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/resume/check": {
      "get": {
        "tags": [
          "RESUME"
        ],
        "summary": "Check Resume",
        "description": "Build the resume and run the ATS check on its PDF.\n\nReturns\n-------\nAtsReportResource\n    The extracted text and the issues found.",
        "operationId": "RESUME-check_resume",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "template",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "description": "Template name.",
              "default": "classic",
              "title": "Template"
            },
            "description": "Template name."
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Lang",
              "description": "Language of the resume.",
              "default": "pt"
            },
            "description": "Language of the resume."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AtsReportResource"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AtsIssueResource": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "AtsIssueResource",
        "description": "Problem found in the text extracted from a resume PDF."
      },
      "AtsReportResource": {
        "properties": {
          "passed": {
            "type": "boolean",
            "title": "Passed"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/AtsIssueResource"
            },
            "type": "array",
            "title": "Issues"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "passed",
          "issues",
          "text"
        ],
        "title": "AtsReportResource",
        "description": "Result of the ATS check of a built resume."
      },
      "AuthenticationChallengeRequestResource": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email",
            "title": "Email",
            "examples": [
              "ana@example.com"
            ]
          },
          "language": {
            "type": "string",
            "enum": [
              "pt-BR",
              "en-US"
            ],
            "title": "Language",
            "description": "Language of the email, and of the account if it is new.",
            "default": "pt-BR"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "AuthenticationChallengeRequestResource",
        "description": "HTTP payload used to request a login code by email."
      },
      "AuthenticationChallengeResource": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 32,
            "title": "Challenge Id"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "expires_in_seconds": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expires In Seconds"
          }
        },
        "type": "object",
        "required": [
          "challenge_id",
          "expires_at",
          "expires_in_seconds"
        ],
        "title": "AuthenticationChallengeResource",
        "description": "Public authentication challenge, the same for known and new emails."
      },
      "AuthenticationCodeResource": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 6,
            "minLength": 6,
            "pattern": "^[0-9]{6}$",
            "title": "Code",
            "examples": [
              "482913"
            ]
          },
          "device_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Device Id"
          },
          "platform": {
            "type": "string",
            "enum": [
              "android",
              "ios",
              "web"
            ],
            "title": "Platform"
          },
          "device_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Name"
          }
        },
        "type": "object",
        "required": [
          "code",
          "device_id",
          "platform"
        ],
        "title": "AuthenticationCodeResource",
        "description": "HTTP payload used to verify a code for one app or browser installation."
      },
      "AuthenticationRefreshResource": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "maxLength": 512,
            "minLength": 32,
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "AuthenticationRefreshResource",
        "description": "HTTP payload carrying a rotating refresh token."
      },
      "AuthenticationSessionListResource": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AuthenticationSessionSummaryResource"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "AuthenticationSessionListResource",
        "description": "List of active device sessions owned by a user."
      },
      "AuthenticationSessionResource": {
        "properties": {
          "auth_session_id": {
            "type": "integer",
            "title": "Auth Session Id"
          },
          "access_token": {
            "type": "string",
            "minLength": 32,
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          },
          "access_expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Access Expires At"
          },
          "access_expires_in_seconds": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Access Expires In Seconds"
          },
          "refresh_token": {
            "type": "string",
            "minLength": 32,
            "title": "Refresh Token"
          },
          "refresh_expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Refresh Expires At"
          },
          "refresh_expires_in_seconds": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Refresh Expires In Seconds"
          },
          "is_new_user": {
            "type": "boolean",
            "title": "Is New User"
          },
          "user": {
            "$ref": "#/components/schemas/UserResource"
          }
        },
        "type": "object",
        "required": [
          "auth_session_id",
          "access_token",
          "access_expires_at",
          "access_expires_in_seconds",
          "refresh_token",
          "refresh_expires_at",
          "refresh_expires_in_seconds",
          "is_new_user",
          "user"
        ],
        "title": "AuthenticationSessionResource",
        "description": "Access and refresh tokens issued after authentication."
      },
      "AuthenticationSessionSummaryResource": {
        "properties": {
          "auth_session_id": {
            "type": "integer",
            "title": "Auth Session Id"
          },
          "device_id": {
            "type": "string",
            "title": "Device Id"
          },
          "device_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Name"
          },
          "platform": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Platform"
          },
          "authenticated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Authenticated At"
          },
          "last_used_at": {
            "type": "string",
            "format": "date-time",
            "title": "Last Used At"
          },
          "access_expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Access Expires At"
          },
          "absolute_expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Absolute Expires At"
          }
        },
        "type": "object",
        "required": [
          "auth_session_id",
          "device_id",
          "device_name",
          "platform",
          "authenticated_at",
          "last_used_at",
          "access_expires_at",
          "absolute_expires_at"
        ],
        "title": "AuthenticationSessionSummaryResource",
        "description": "Safe representation of one authenticated device session."
      },
      "Basics": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "headline": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "location": {
            "type": "string",
            "title": "Location"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "links": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Links",
            "description": "Visible link text, such as linkedin.com/in/user."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "headline",
          "location",
          "email"
        ],
        "title": "Basics",
        "description": "Header of the resume. Contact data stays in the page body."
      },
      "Bullet": {
        "properties": {
          "id": {
            "type": "string",
